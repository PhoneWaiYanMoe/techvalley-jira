# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for OAuth/reset-password redirects (Vercel deployment URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider — not yet chosen (Claude/GPT/Gemini), see CLAUDE.md "Known limitations"
# AI_PROVIDER=
# AI_API_KEY=

# Transactional email for team invites (FR-013) — SendGrid, sent directly from
# our own backend via their HTTP API (separate from Supabase Auth's SMTP config,
# which only covers Supabase's own signup-confirm/password-reset emails)
EMAIL_PROVIDER_API_KEY=
EMAIL_SENDER_ADDRESS=

# Shared secret for POST /api/notifications/check-due-dates (FR-090 due-soon/
# due-today) — protects the endpoint since it's meant for an external
# scheduler (Vercel Cron post-deploy), not a logged-in user. Any random
# string works; generate one with `openssl rand -hex 32`.
CRON_SECRET=
